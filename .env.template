# ══════════════════════════════════════════════════════════
# .env — Sanlyn API Environment Variables
# Copy to .env and fill in real values
# ══════════════════════════════════════════════════════════

# ── PostgreSQL (Alibaba Cloud RDS) ──
PG_HOST=pgm-j6c92e9e7xe2qvingo.pg.rds.aliyuncs.com
PG_PORT=5432
PG_DATABASE=sanlyn_db
PG_USER=sanlyn_admin
PG_PASSWORD=<your-rds-password>

# ── Alibaba Cloud OSS ──
OSS_REGION=oss-cn-hongkong
OSS_BUCKET=sanlyn-files
OSS_ACCESS_KEY_ID=<your-ak>
OSS_ACCESS_KEY_SECRET=<your-sk>

# ── JDY API ──
JDY_TOKEN=<your-jdy-token>
JDY_APP_ID=<your-jdy-app-id>

# ── CRON ──
CRON_SECRET=<your-cron-secret>

# ── Server ──
PORT=9000

# ── MiniMax (Task Workspace V1.5 真调) ──
# Get key from MiniMax dashboard. Required by /api/minimax-chat.
MINIMAX_API_KEY=<your-minimax-key>

# ── Local-dev bypass for /api/minimax-chat ONLY ──
# When set to 1 AND NODE_ENV != production, /api/minimax-chat skips JWT auth.
# Lets Damon test from localhost:5188 without full login. NEVER set in prod.
# Server-side rate-limit + daily cap still apply.
MINIMAX_CHAT_DEV_BYPASS_AUTH=0
