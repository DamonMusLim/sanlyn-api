{
  "template_key": "ar_customer",
  "name": "客户应收对账",
  "roles": [
    { "role": "finance", "scope": "all" },
    { "role": "customer", "scope_field": "customer", "token": ["recon_links", "magic_links"] }
  ],
  "expected": {
    "source_type": "sql",
    "period_field": "COALESCE(etd, order_date, created_at)",
    "sql": "SELECT o.contract_no, string_agg(DISTINCT o.order_no, ',') AS order_no, MAX(o.customer) AS customer, MAX(o.issuing_company) AS issuing_company, MAX(o.company_code) AS company_code, MIN(COALESCE(o.etd, o.order_date, o.created_at))::date AS period_date, SUM(COALESCE(o.customer_total_amount, o.customer_amount, o.total_amount)) AS expected_amount, MAX(o.currency) AS currency FROM orders o WHERE o.deleted_at IS NULL AND COALESCE(o.status,'') <> 'cancelled' AND COALESCE(o.etd, o.order_date, o.created_at) >= $1::date AND COALESCE(o.etd, o.order_date, o.created_at) < $2::date GROUP BY o.contract_no ORDER BY o.contract_no"
  },
  "actual": {
    "source_type": "sql",
    "sql": "SELECT fio.id AS invoice_id, fio.invoice_no, fio.issue_date, fio.buyer_name, fio.seller_company_code, fio.amount_incl_tax AS actual_amount, fio.currency, fio.review_status, c.contract_no FROM finance_invoices_out fio CROSS JOIN LATERAL unnest(fio.contract_nos) AS c(contract_no) WHERE COALESCE(fio.void_status,'') NOT IN ('void','red_ink','cancelled','作废','已作废')"
  },
  "match_keys": ["contract_no"],
  "amount_fields": {
    "expected": "expected_amount",
    "actual": "actual_amount",
    "tolerance": 1
  },
  "status_machine": {
    "initial": "pending_confirm",
    "terminal": ["completed"],
    "rules": [
      { "when": "expected_amount == null", "status": "need_amount" },
      { "when": "confirmed_at == null && actual_amount == 0", "status": "pending_confirm" },
      { "when": "confirmed_at != null && actual_amount == 0", "status": "confirmed_wait_invoice" },
      { "when": "abs(diff_amount) <= tolerance_amount", "status": "matched" },
      { "when": "actual_amount < expected_amount - tolerance_amount", "status": "partial_uploaded" },
      { "when": "actual_amount > expected_amount + tolerance_amount", "status": "over_issued" }
    ],
    "manual_transitions": ["completed", "reopen", "void", "override_amount"]
  },
  "field_schema": [
    { "key": "contract_no", "label": "合同号", "source": "expected.contract_no" },
    { "key": "order_no", "label": "订单号", "source": "expected.order_no" },
    { "key": "customer", "label": "客户", "source": "expected.customer" },
    { "key": "issuing_company", "label": "我方主体", "source": "expected.issuing_company" },
    { "key": "company_code", "label": "客户编码", "source": "expected.company_code" },
    { "key": "period_date", "label": "期间日期", "source": "expected.period_date" },
    { "key": "expected_amount", "label": "应收金额", "source": "expected.expected_amount" },
    { "key": "uploaded_amount", "label": "已开票金额", "source": "actual.actual_amount" },
    { "key": "diff_amount", "label": "差额", "source": "computed" },
    { "key": "currency", "label": "币种", "source": "expected.currency" },
    { "key": "status", "label": "状态", "source": "computed" }
  ],
  "visibility_rules": {
    "finance": { "include": ["*"] },
    "customer": {
      "include": ["contract_no", "order_no", "expected_amount", "uploaded_amount", "status"],
      "exclude": ["raw", "source_payload", "other_customer_rows"]
    }
  }
}
