#!/usr/bin/env bash
# 后端唯一部署路径 v2: mini canonical -> tencent.
# 只传内容真变的文件(--checksum,不被mtime/chattr锁干扰),自动解锁→传→重锁。
# 铁律: 只在 ~/canonical/sanlyn-api 改代码,改完先 commit; 绝不直接改 tencent。
set -euo pipefail
CANON="$HOME/canonical/sanlyn-api"
RDIR="/opt/sanlyn-api-test"
cd "$CANON"

EXCL=(--exclude='.git' --exclude='node_modules' --exclude='.env'
      --exclude='*.bak' --exclude='*.bak.*' --exclude='*.bak-*'
      --exclude='fix_*.mjs' --exclude='fix_*.js' --exclude='oli_repair.mjs'
      --exclude='rebate_gaps.mjs' --exclude='sync-plan-aggregates.mjs' --exclude='_audit_severity.mjs')

# 0. canonical 必须干净
if [ -n "$(/usr/bin/git status --porcelain)" ]; then
  echo "🛑 canonical 有未提交改动,先 commit 再部署:"; /usr/bin/git status --short; exit 1
fi
BR="$(/usr/bin/git rev-parse --abbrev-ref HEAD)"
if [ "$BR" != "snapshot/prod-20260628" ]; then
  echo "🛑 分支不对: $BR (应在 snapshot/prod-20260628)"; exit 1
fi

# 1. 算出内容真变的文件(checksum dry-run)
echo "[1/6] 计算变更文件(checksum)..."
mapfile -t CHANGED < <(rsync -rln --checksum --out-format='%n' "${EXCL[@]}" "$CANON"/ tencent:"$RDIR"/ 2>/dev/null | grep -vE '/$' | grep -v '^$' || true)
if [ "${#CHANGED[@]}" -eq 0 ]; then echo "✅ 无内容变更,无需部署"; exit 0; fi
printf '   变更: %s\n' "${CHANGED[@]}"

# 2. tencent 预部署备份
echo "[2/6] 备份 tencent..."
ssh tencent 'cd /opt && TS=$(date +%Y%m%d-%H%M%S) && tar czf /opt/sanlyn-api-backups/predeploy-$TS.tar.gz --exclude=sanlyn-api-test/node_modules sanlyn-api-test >/dev/null 2>&1 && echo "   备份OK $TS"'

# 3. 解锁变更文件中被 chattr +i 锁的(记录,部署后重锁)
echo "[3/6] 解锁被锁的变更文件..."
printf '%s\n' "${CHANGED[@]}" | ssh tencent 'cd '"$RDIR"'; rm -f /tmp/relock.list; while read -r f; do [ -z "$f" ] && continue; if lsattr "$f" 2>/dev/null | cut -d" " -f1 | grep -q i; then chattr -i "$f" && echo "$f" >> /tmp/relock.list && echo "   解锁 $f"; fi; done'

# 4. 实际传输(只传变更,checksum)
echo "[4/6] 传输..."
rsync -rl --checksum --no-times "${EXCL[@]}" "$CANON"/ tencent:"$RDIR"/

# 5. 重锁
echo "[5/6] 重锁..."
ssh tencent 'cd '"$RDIR"'; if [ -f /tmp/relock.list ]; then while read -r f; do chattr +i "$f" 2>/dev/null && echo "   重锁 $f"; done < /tmp/relock.list; rm -f /tmp/relock.list; fi'

# 5.5 跑 DB migration(幂等,只跑未应用的;DB在tencent本地)
echo "[5.5] 跑 DB migration..."
ssh tencent 'cd '"$RDIR"' && node scripts/apply-migrations.js'

# 6. node 自检 + 重启 + 健康
echo "[6/6] node 自检 + 重启..."
ssh tencent 'cd '"$RDIR"' && node --check server.js && pm2 restart sanlyn-api >/dev/null && sleep 2 && pm2 logs sanlyn-api --lines 5 --nostream 2>/dev/null | grep -iE "listening|error" | tail -3'
COMMIT="$(/usr/bin/git rev-parse --short HEAD)"
ssh tencent 'cat > '"$RDIR"'/DEPLOYED_VERSION' <<EOV
repo=sanlyn-api
branch=snapshot/prod-20260628
commit='"$COMMIT"'
deployed_at='"$(date -Iseconds)"'
EOV
echo "✅ 部署完成 (commit $COMMIT)。记得 git push origin snapshot/prod-20260628。"
